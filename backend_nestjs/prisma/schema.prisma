datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(255)
  description String?
  color       String?   @default("#3b82f6") @db.VarChar(7)
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @db.Timestamp(6)
  Note        Note[]

  @@index([name], map: "idx_category_name")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Note {
  id         Int       @id @default(autoincrement())
  content    String
  categoryId Int
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @db.Timestamp(6)
  Category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([categoryId], map: "idx_note_categoryid")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Subtask {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(255)
  completed Boolean?  @default(false)
  todoId    Int
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  Todo      Todo      @relation(fields: [todoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([todoId], map: "idx_subtask_todoid")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Todo {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?
  completed   Boolean?  @default(false)
  priority    String?   @default("medium") @db.VarChar(50)
  dueDate     DateTime? @db.Timestamp(6)
  tags        String?   @db.VarChar(255)
  userId      Int
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @db.Timestamp(6)
  Subtask     Subtask[]
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([completed], map: "idx_todo_completed")
  @@index([dueDate], map: "idx_todo_duedate")
  @@index([priority], map: "idx_todo_priority")
  @@index([userId], map: "idx_todo_userid")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(100)
  name      String?   @db.VarChar(255)
  password  String    @db.VarChar(255)
  active    Boolean?  @default(true)
  role      String?   @default("user") @db.VarChar(50)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  Todo      Todo[]
  age       Int?

  @@index([active], map: "idx_user_active")
  @@index([email], map: "idx_user_email")
}
