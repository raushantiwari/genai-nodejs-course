# Development Dockerfile
FROM node:22-alpine AS base

WORKDIR /app

# Enable pnpm via Corepack (IMPORTANT)
RUN corepack enable

# Copy lock files first (better caching)
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install

# Copy source code
COPY . .

# Expose Next.js dev port
EXPOSE 3000

# Start Next.js in dev mode with hot reloading
# The container still runs on port 3000 internally, mapped to 8082 externally
CMD ["pnpm", "run", "dev"]
